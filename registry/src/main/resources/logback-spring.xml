<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- default logback configuration    -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="com.cvshealth.cap.registry.service.audit.AuditLogFilter">
            <LoggerName>com.cvshealth.cap.registry.service.audit.AuditServiceLogPublisher</LoggerName>
            <OnMismatch>NEUTRAL</OnMismatch>
            <OnMatch>DENY</OnMatch>
        </filter>
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp/>
                <logLevel><fieldName>severity</fieldName></logLevel>
                <logLevelValue/>
                <threadName/>
                <mdc/>
                <loggerName/>
                <message />
                <stackHash />
                <stackTrace>
                    <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                        <maxDepthPerThrowable>30</maxDepthPerThrowable>
                        <maxLength>2048</maxLength>
                        <shortenedClassNameLength>20</shortenedClassNameLength>
                        <rootCauseFirst>true</rootCauseFirst>
                    </throwableConverter>
                </stackTrace>
            </providers>
        </encoder>
    </appender>

    <appender name="AUDIT_LOGGER" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="com.cvshealth.cap.registry.service.audit.AuditLogFilter">
            <LoggerName>com.cvshealth.cap.registry.service.audit.AuditServiceLogPublisher</LoggerName>
            <OnMismatch>NEUTRAL</OnMismatch>
            <OnMatch>ACCEPT</OnMatch>
        </filter>
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp/>
                <logLevel><fieldName>severity</fieldName></logLevel>
                <logLevelValue/>
                <threadName/>
                <mdc/>
                <loggerName/>
                <message />
                <stackHash />
                <stackTrace>
                    <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                        <maxDepthPerThrowable>30</maxDepthPerThrowable>
                        <maxLength>2048</maxLength>
                        <shortenedClassNameLength>20</shortenedClassNameLength>
                        <rootCauseFirst>true</rootCauseFirst>
                    </throwableConverter>
                </stackTrace>
            </providers>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="AUDIT_LOGGER"/>
    </root>
</configuration>
