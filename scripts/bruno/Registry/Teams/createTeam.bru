meta {
  name: createTeam
  type: graphql
  seq: 5
}

post {
  url: {{registryUrl}}/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  mutation createTeam($team: TeamRequestInput!) {
    createTeam(team: $team) {
      id
      version
      name
      type
      description
      emailList
      slackChannel
      slackChannelName
      externalName
      createUser
      createTimestamp
      updateUser
      updateTimestamp
    }
  }
}

body:graphql:vars {
  {
    "team": {
      "name": "{{teamName}}",
      "type": "SHARED",
      "description": "Created from the Registry Bruno collection",
      "emailList": "",
      "slackChannel": ""
    }
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("no GraphQL errors", function() {
    expect(res.getBody().errors).to.be.undefined;
  });
}

docs {
  `type` is `SHARED` or `PERSONAL`.
}
