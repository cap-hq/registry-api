meta {
  name: getTeams
  type: graphql
  seq: 1
}

post {
  url: {{registryUrl}}/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  query getTeams($paginationInput: PaginationInput!, $filter: TeamSearchFilterInput) {
    getTeams(paginationInput: $paginationInput, filter: $filter) {
      pageNumber
      pageSize
      totalRecordCount
      totalPageCount
      teams {
        id
        version
        name
        type
        description
        emailList
        slackChannel
        slackChannelName
        externalName
        createUser
        createTimestamp
        updateUser
        updateTimestamp
      }
    }
  }
}

body:graphql:vars {
  {
    "paginationInput": {
      "pageNumber": 1,
      "pageSize": 20
    },
    "filter": {}
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("no GraphQL errors", function() {
    expect(res.getBody().errors).to.be.undefined;
  });
}
