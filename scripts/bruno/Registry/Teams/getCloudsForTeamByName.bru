meta {
  name: getCloudsForTeamByName
  type: graphql
  seq: 4
}

post {
  url: {{registryUrl}}/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  query getCloudsForTeamByName($teamName: String!) {
    getCloudsForTeamByName(teamName: $teamName) {
      name
      tenants
      authorizedTeams
      regions
      defaultRegion
    }
  }
}

body:graphql:vars {
  {
    "teamName": "{{teamName}}"
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("no GraphQL errors", function() {
    expect(res.getBody().errors).to.be.undefined;
  });
}
