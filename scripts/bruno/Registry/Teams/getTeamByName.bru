meta {
  name: getTeamByName
  type: graphql
  seq: 3
}

post {
  url: {{registryUrl}}/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  query getTeamByName($name: String!) {
    getTeamByName(name: $name) {
      id
      version
      name
      type
      description
      emailList
      slackChannel
      slackChannelName
      externalName
      createUser
      createTimestamp
      updateUser
      updateTimestamp
      applications {
        id
        name
      }
      members {
        id
        name
        externalId
        role
      }
      authClients {
        clientId
        clientVersion
        type
      }
    }
  }
}

body:graphql:vars {
  {
    "name": "{{teamName}}"
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("no GraphQL errors", function() {
    expect(res.getBody().errors).to.be.undefined;
  });
}
