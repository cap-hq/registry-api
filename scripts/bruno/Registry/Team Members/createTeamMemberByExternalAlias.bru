meta {
  name: createTeamMemberByExternalAlias
  type: graphql
  seq: 4
}

post {
  url: {{registryUrl}}/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  mutation($teamName: String!, $externalAlias: String!, $role: TeamMemberRole!) {
    createTeamMemberByExternalAlias(teamName: $teamName, externalAlias: $externalAlias, role: $role) {
      teamId
      memberId
      role
      version
      createUser
      createTimestamp
      updateUser
      updateTimestamp
    }
  }
}

body:graphql:vars {
  {
    "teamName": "{{teamName}}",
    "externalAlias": "{{memberExternalAlias}}",
    "role": "MEMBER"
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("no GraphQL errors", function() {
    expect(res.getBody().errors).to.be.undefined;
  });
}
