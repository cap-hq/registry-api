meta {
  name: deleteTeamMemberByExternalAlias
  type: graphql
  seq: 6
}

post {
  url: {{registryUrl}}/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  mutation($teamName: String!, $externalAlias: String!) {
    deleteTeamMemberByExternalAlias(teamName: $teamName, externalAlias: $externalAlias)
  }
}

body:graphql:vars {
  {
    "teamName": "{{teamName}}",
    "externalAlias": "{{memberExternalAlias}}"
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("no GraphQL errors", function() {
    expect(res.getBody().errors).to.be.undefined;
  });
}

docs {
  Destructive.
}
