meta {
  name: updateTeamMemberByExternalId
  type: graphql
  seq: 2
}

post {
  url: {{registryUrl}}/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  mutation($teamName: String!, $externalId: String!, $role: TeamMemberRole!) {
    updateTeamMemberByExternalId(teamName: $teamName, externalId: $externalId, role: $role) {
      teamId
      memberId
      role
      version
      createUser
      createTimestamp
      updateUser
      updateTimestamp
    }
  }
}

body:graphql:vars {
  {
    "teamName": "{{teamName}}",
    "externalId": "{{memberExternalId}}",
    "role": "OWNER"
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("no GraphQL errors", function() {
    expect(res.getBody().errors).to.be.undefined;
  });
}
