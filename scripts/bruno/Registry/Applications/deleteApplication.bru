meta {
  name: deleteApplication
  type: graphql
  seq: 7
}

post {
  url: {{registryUrl}}/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  mutation($name: String!) {
    deleteApplication(name: $name)
  }
}

body:graphql:vars {
  {
    "name": "{{applicationName}}"
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("no GraphQL errors", function() {
    expect(res.getBody().errors).to.be.undefined;
  });
}

docs {
  Destructive.
}
