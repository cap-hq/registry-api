meta {
  name: getApplication
  type: graphql
  seq: 2
}

post {
  url: {{registryUrl}}/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  query($id: Long!) {
    getApplication(id: $id) {
      id
      version
      name
      description
      complianceTypes
      priority
      externalId
      cloud
      tenant
      aiEnabled
      dataPerimeter
      team {
        id
        name
      }
      createUser
      createTimestamp
      updateUser
      updateTimestamp
    }
  }
}

body:graphql:vars {
  {
    "id": 1
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("no GraphQL errors", function() {
    expect(res.getBody().errors).to.be.undefined;
  });
}
