meta {
  name: getApplications
  type: graphql
  seq: 1
}

post {
  url: {{registryUrl}}/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  query getApplications($paginationInput: PaginationInput!, $filter: ApplicationSearchFilterInput) {
    getApplications(paginationInput: $paginationInput, filter: $filter) {
      pageNumber
      pageSize
      totalRecordCount
      totalPageCount
      applications {
        id
        version
        name
        description
        complianceTypes
        priority
        externalId
        cloud
        tenant
        aiEnabled
        dataPerimeter
        team {
          id
          name
        }
        createUser
        createTimestamp
        updateUser
        updateTimestamp
      }
    }
  }
}

body:graphql:vars {
  {
    "paginationInput": {
      "pageNumber": 1,
      "pageSize": 20
    },
    "filter": {}
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("no GraphQL errors", function() {
    expect(res.getBody().errors).to.be.undefined;
  });
}
