meta {
  name: getExternalUsers
  type: graphql
  seq: 1
}

post {
  url: {{registryUrl}}/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  query($nameOrEmail: String!, $includedDisabledAccounts: Boolean) {
    getExternalUsers(nameOrEmail: $nameOrEmail, includedDisabledAccounts: $includedDisabledAccounts) {
      externalId
      externalAlias
      employeeId
      displayName
      firstName
      lastName
      email
      accountEnabled
    }
  }
}

body:graphql:vars {
  {
    "nameOrEmail": "{{memberEmail}}",
    "includedDisabledAccounts": false
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("no GraphQL errors", function() {
    expect(res.getBody().errors).to.be.undefined;
  });
}
