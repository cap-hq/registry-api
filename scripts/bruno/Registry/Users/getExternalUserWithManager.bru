meta {
  name: getExternalUserWithManager
  type: graphql
  seq: 2
}

post {
  url: {{registryUrl}}/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  query($externalId: String!) {
    getExternalUserWithManager(externalId: $externalId) {
      externalId
      externalAlias
      employeeId
      displayName
      firstName
      lastName
      email
      accountEnabled
      manager {
        externalId
        externalAlias
        employeeId
        displayName
        firstName
        lastName
        email
        accountEnabled
      }
    }
  }
}

body:graphql:vars {
  {
    "externalId": "{{memberExternalId}}"
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("no GraphQL errors", function() {
    expect(res.getBody().errors).to.be.undefined;
  });
}
