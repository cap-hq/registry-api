meta {
  name: getApplicationTransfersForTeamsByName
  type: graphql
  seq: 5
}

post {
  url: {{registryUrl}}/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  query($paginationInput: PaginationInput!, $filter: ApplicationTransferSearchFilterInput) {
    getApplicationTransfersForTeamsByName(paginationInput: $paginationInput, filter: $filter) {
      pageNumber
      pageSize
      totalRecordCount
      totalPageCount
      applicationTransfers {
        id
        status
        comments
        version
        application {
          id
          name
        }
        sourceTeam {
          id
          name
        }
        receiveTeam {
          id
          name
        }
        createUser
        createTimestamp
        updateUser
        updateTimestamp
      }
    }
  }
}

body:graphql:vars {
  {
    "paginationInput": {
      "pageNumber": 1,
      "pageSize": 20
    },
    "filter": {
      "teamNames": [
        "{{teamName}}"
      ]
    }
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("no GraphQL errors", function() {
    expect(res.getBody().errors).to.be.undefined;
  });
}
