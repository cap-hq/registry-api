meta {
  name: getApplicationTransfers
  type: graphql
  seq: 1
}

post {
  url: {{registryUrl}}/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  query {
    getApplicationTransfers {
      id
      applicationId
      sourceTeamId
      receiveTeamId
      status
      comments
      version
      createUser
      createTimestamp
      updateUser
      updateTimestamp
    }
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("no GraphQL errors", function() {
    expect(res.getBody().errors).to.be.undefined;
  });
}
