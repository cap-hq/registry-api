meta {
  name: getMembers
  type: graphql
  seq: 1
}

post {
  url: {{registryUrl}}/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  query getMembers($paginationInput: PaginationInput!, $filter: MemberSearchFilterInput) {
    getMembers(paginationInput: $paginationInput, filter: $filter) {
      pageNumber
      pageSize
      totalRecordCount
      totalPageCount
      members {
        id
        version
        externalId
        externalAlias
        employeeId
        email
        name
        firstName
        lastName
        managerExternalId
        createUser
        createTimestamp
        updateUser
        updateTimestamp
        teams {
          id
          name
          role
        }
      }
    }
  }
}

body:graphql:vars {
  {
    "paginationInput": {
      "pageNumber": 1,
      "pageSize": 20
    },
    "filter": {}
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("no GraphQL errors", function() {
    expect(res.getBody().errors).to.be.undefined;
  });
}
