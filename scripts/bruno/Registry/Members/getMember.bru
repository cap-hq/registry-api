meta {
  name: getMember
  type: graphql
  seq: 2
}

post {
  url: {{registryUrl}}/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  query getMember($id: Long!) {
    getMember(id: $id) {
      id
      version
      externalId
      externalAlias
      employeeId
      email
      name
      firstName
      lastName
      managerExternalId
      createUser
      createTimestamp
      updateUser
      updateTimestamp
      teams {
        id
        name
        role
      }
    }
  }
}

body:graphql:vars {
  {
    "id": 1
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("no GraphQL errors", function() {
    expect(res.getBody().errors).to.be.undefined;
  });
}
