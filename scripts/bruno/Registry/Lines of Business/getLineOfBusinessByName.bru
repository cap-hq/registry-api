meta {
  name: getLineOfBusinessByName
  type: graphql
  seq: 3
}

post {
  url: {{registryUrl}}/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  query($name: String!) {
    getLineOfBusinessByName(name: $name) {
      id
      version
      name
      description
      managers {
        managerExternalId
        managerName
      }
      createUser
      createTimestamp
      updateUser
      updateTimestamp
    }
  }
}

body:graphql:vars {
  {
    "name": "{{lineOfBusinessName}}"
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("no GraphQL errors", function() {
    expect(res.getBody().errors).to.be.undefined;
  });
}
