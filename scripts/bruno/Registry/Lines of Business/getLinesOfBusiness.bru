meta {
  name: getLinesOfBusiness
  type: graphql
  seq: 1
}

post {
  url: {{registryUrl}}/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  query {
    getLinesOfBusiness {
      id
      version
      name
      description
      managers {
        managerExternalId
        managerName
      }
      createUser
      createTimestamp
      updateUser
      updateTimestamp
    }
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("no GraphQL errors", function() {
    expect(res.getBody().errors).to.be.undefined;
  });
}
