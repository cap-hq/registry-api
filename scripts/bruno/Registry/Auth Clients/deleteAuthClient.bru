meta {
  name: deleteAuthClient
  type: graphql
  seq: 6
}

post {
  url: {{registryUrl}}/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  mutation($clientId: String!, $clientVersion: Int) {
    deleteAuthClient(clientId: $clientId, clientVersion: $clientVersion)
  }
}

body:graphql:vars {
  {
    "clientId": "registry-demo-client",
    "clientVersion": null
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("no GraphQL errors", function() {
    expect(res.getBody().errors).to.be.undefined;
  });
}

docs {
  Destructive.
}
