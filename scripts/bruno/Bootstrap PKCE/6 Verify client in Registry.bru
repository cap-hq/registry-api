meta {
  name: 6 Verify client in Registry
  type: graphql
  seq: 4
}

post {
  url: {{registryUrl}}/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  query($clientId: String!) {
    getAuthClient(clientId: $clientId) {
      id
      clientId
      clientVersion
      clientSecret
      clientSecretExpiresAt
      description
      type
      redirectUrls
      accessTokenExpireMinutes
      refreshTokenExpireMinutes
      lastAccessTokenIssuedAt
      createUser
      createTimestamp
      updateUser
      updateTimestamp
      teams {
        id
        name
      }
    }
  }
}

body:graphql:vars {
  {
    "clientId": "{{bootstrapClientId}}"
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("no GraphQL errors", function() {
    expect(res.getBody().errors).to.be.undefined;
  });
}

docs {
  Registry's own record of `BOOTSTRAP_CLIENT_ID` (owning team, redirect URLs, version). Uses `X-Api-Secret` from the folder.
}
