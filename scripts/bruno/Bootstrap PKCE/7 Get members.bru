meta {
  name: 7 Get members
  type: graphql
  seq: 5
}

post {
  url: {{registryUrl}}/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  query getMembers($paginationInput: PaginationInput!, $filter: MemberSearchFilterInput) {
    getMembers(paginationInput: $paginationInput, filter: $filter) {
      totalRecordCount
      members {
        id
        externalId
        externalAlias
        employeeId
        email
        name
        createUser
        createTimestamp
        teams {
          name
          role
        }
      }
    }
  }
}

body:graphql:vars {
  {
    "paginationInput": {
      "pageNumber": 1,
      "pageSize": 20
    }
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("no GraphQL errors", function() {
    expect(res.getBody().errors).to.be.undefined;
  });
}

docs {
  Member records in Registry. Your first PKCE sign-in (`bootstrap.sh` step 1) creates yours from the token's externalId/employeeId; `teams` shows the bootstrap team and your role on it.
}
