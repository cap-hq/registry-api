meta {
  name: POST token - client credentials
  type: http
  seq: 3
}

post {
  url: {{authUrl}}/oauth2/token
  body: formUrlEncoded
  auth: basic
}

auth:basic {
  username: {{demoClientId}}
  password: {{demoClientSecret}}
}

body:form-urlencoded {
  grant_type: client_credentials
  scope: {{oauthClientScopes}}
}

vars:post-response {
  clientCredentialsToken: res.body.access_token
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Client-credentials grant for a confidential (`NON_USER`/`USER`) client. Uses the Bootstrap client id/secret from `.env`.
}
