meta {
  name: POST introspect
  type: http
  seq: 4
}

post {
  url: {{authUrl}}/oauth2/introspect
  body: formUrlEncoded
  auth: basic
}

auth:basic {
  username: {{demoClientId}}
  password: {{demoClientSecret}}
}

body:form-urlencoded {
  token: {{clientCredentialsToken}}
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
