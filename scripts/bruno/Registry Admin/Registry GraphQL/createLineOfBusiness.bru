meta {
  name: createLineOfBusiness
  type: graphql
  seq: 1
}

post {
  url: {{registryUrl}}/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  mutation($lineOfBusiness: LineBusinessRequestInput!) {
    createLineOfBusiness(lineOfBusiness: $lineOfBusiness) {
      id
      version
      name
      description
      managers {
        managerExternalId
        managerName
      }
      createUser
      createTimestamp
      updateUser
      updateTimestamp
    }
  }
}

body:graphql:vars {
  {
    "lineOfBusiness": {
      "name": "{{lineOfBusinessName}}",
      "description": "Created from the Registry Bruno collection",
      "managerExternalIds": [
        "{{managerExternalId}}"
      ]
    }
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("no GraphQL errors", function() {
    expect(res.getBody().errors).to.be.undefined;
  });
}
