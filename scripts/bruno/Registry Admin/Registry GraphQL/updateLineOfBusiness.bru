meta {
  name: updateLineOfBusiness
  type: graphql
  seq: 2
}

post {
  url: {{registryUrl}}/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  mutation($lineOfBusiness: LineBusinessUpdateRequestInput!) {
    updateLineOfBusiness(lineOfBusiness: $lineOfBusiness) {
      id
      version
      name
      description
      managers {
        managerExternalId
        managerName
      }
      createUser
      createTimestamp
      updateUser
      updateTimestamp
    }
  }
}

body:graphql:vars {
  {
    "lineOfBusiness": {
      "id": 1,
      "name": "{{lineOfBusinessName}}",
      "description": "Updated from the Registry Bruno collection",
      "managerExternalIds": [
        "{{managerExternalId}}"
      ]
    }
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("no GraphQL errors", function() {
    expect(res.getBody().errors).to.be.undefined;
  });
}
