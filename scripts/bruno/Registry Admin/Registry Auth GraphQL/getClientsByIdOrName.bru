meta {
  name: getClientsByIdOrName
  type: graphql
  seq: 3
}

post {
  url: {{authUrl}}/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  query($clientIdOrName: String!) {
    getClientsByIdOrName(clientIdOrName: $clientIdOrName) {
      id
      type
      clientId
      clientName
      clientSecretExpiresAt
      redirectUrls
      accessTokenExpireMinutes
      refreshTokenExpireMinutes
      lastAccessTokenIssuedAt
    }
  }
}

body:graphql:vars {
  {
    "clientIdOrName": "registry"
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("no GraphQL errors", function() {
    expect(res.getBody().errors).to.be.undefined;
  });
}
