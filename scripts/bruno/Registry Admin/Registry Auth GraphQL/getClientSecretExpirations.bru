meta {
  name: getClientSecretExpirations
  type: graphql
  seq: 4
}

post {
  url: {{authUrl}}/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  query {
    getClientSecretExpirations {
      clientId
      clientName
      clientIdIssuedAt
      clientSecretExpiresAt
      ageInDays
      expirationInDays
      lastAccessTokenIssuedAt
    }
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("no GraphQL errors", function() {
    expect(res.getBody().errors).to.be.undefined;
  });
}
