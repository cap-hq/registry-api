meta {
  name: getClients
  type: graphql
  seq: 1
}

post {
  url: {{authUrl}}/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  query {
    getClients {
      id
      type
      clientId
      clientName
      clientSecretExpiresAt
      redirectUrls
      accessTokenExpireMinutes
      refreshTokenExpireMinutes
      lastAccessTokenIssuedAt
    }
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("no GraphQL errors", function() {
    expect(res.getBody().errors).to.be.undefined;
  });
}
