# Copy to scripts/bruno/.env (gitignored). Values here are read via {{process.env.X}}
# in environments/Local.bru and environments/Cloud.bru.

# Shared service secret accepted by Registry, Registry Auth and Registry Rollup
# as the X-Api-Secret header. Must match REGISTRY_API_SECRET on the services.
REGISTRY_API_SECRET=change-me

# OAuth scopes. User scopes are requested by the collection's authorization-code (PKCE) login;
# client scopes are sent on client-credentials token requests. Space separated.
OAUTH_USER_SCOPES=openid profile email
OAUTH_CLIENT_SCOPES=

# Identity values used by Registry member/team requests (Azure AD object id / alias / email).
MEMBER_EXTERNAL_ID=00000000-0000-0000-0000-000000000000
MEMBER_EXTERNAL_ALIAS=jdoe
MEMBER_EMAIL=jdoe@example.com

# Optional: user injected via the X-External-User-Id header (Registry `local` profile dev-auth).
DEV_USER_EXTERNAL_ID=00000000-0000-0000-0000-000000000000

# Used by Registry Admin / manager lookups and Line of Business managers.
MANAGER_EXTERNAL_ID=00000000-0000-0000-0000-000000000000

# Used by Registry Admin / Slack channel info.
SLACK_CHANNEL_ID=C0000000000

# Bootstrap / Bootstrap PKCE folders: what bootstrap.sh created (read back, never changed here).
# Defaults match the script's defaults; change them only if you answered the prompts differently.
BOOTSTRAP_CLIENT_ID=registry-user-pkce
BOOTSTRAP_TEAM_NAME=registry-admin
# Demo client that "Bootstrap PKCE / 8 Create client" registers on that team and "10 Cleanup" deletes.
DEMO_CLIENT_ID=registry-user
DEMO_CLIENT_NAME=Registry demo web client
# USER | USER_PKCE | NON_USER
DEMO_CLIENT_TYPE=USER
DEMO_REDIRECT_URL=http://localhost:3000/callback
# Paste the clientSecret returned once by step 8. Used by "Registry Auth / OAuth2 & OIDC /
# POST token - client credentials", "introspect" and "revoke" (confidential clients only).
DEMO_CLIENT_SECRET=
